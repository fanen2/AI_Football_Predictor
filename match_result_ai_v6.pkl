import pandas as pd

from sklearn.preprocessing import LabelEncoder

print("=" * 50)
print("AI Football Predictor by Fanen")
print("MATCH RESULT AI V6")
print("=" * 50)

print("\nLoading Final AI Dataset...")

data = pd.read_csv(
    "/storage/emulated/0/Download/final_ai_dataset.csv"
)

data = data.dropna()

print("Dataset Loaded Successfully!")
print("Total Matches:", len(data))

# Encode teams
team_encoder = LabelEncoder()

all_teams = pd.concat([
    data["HomeTeam"],
    data["AwayTeam"]
])

team_encoder.fit(all_teams)

data["HomeTeam"] = team_encoder.transform(data["HomeTeam"])
data["AwayTeam"] = team_encoder.transform(data["AwayTeam"])

# Encode results
result_encoder = LabelEncoder()

data["FTR"] = result_encoder.fit_transform(data["FTR"])

print("Encoding Completed!")
print("\nBuilding AI Feature Matrix...")

features = [
    "HomeTeam",
    "AwayTeam",

    "HomeRecentPoints",
    "AwayRecentPoints",

    "HomeWinRate",
"AwayWinRate",

    "H2HHomeWins",
    "H2HAwayWins",
    "H2HDraws",
    "H2HGoalsAvg",

    "HomeAttackStrength",
    "AwayAttackStrength",

    "HomeDefenseStrength",
    "AwayDefenseStrength",

    "ExpectedHomeGoals",
    "ExpectedAwayGoals"
]

X = data[features]
y = data["FTR"]

print("Feature Matrix Created Successfully!")
print("Number of Features:", len(features))
print("Training Samples:", len(X))
from sklearn.model_selection import train_test_split
from sklearn.ensemble import HistGradientBoostingClassifier
from sklearn.metrics import accuracy_score
import joblib

print("\nPreparing Training Data...")

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y
)

print("Training Samples:", len(X_train))
print("Testing Samples:", len(X_test))

print("\nTraining HistGradientBoosting AI...")

model = HistGradientBoostingClassifier(
    learning_rate=0.05,
    max_iter=300,
    max_depth=8,
    random_state=42
)

model.fit(X_train, y_train)

print("Training Completed!")

predictions = model.predict(X_test)

accuracy = accuracy_score(y_test, predictions)

print("\nAccuracy:", round(accuracy * 100, 2), "%")

joblib.dump(
    model,
    "/storage/emulated/0/Download/match_result_ai_v6.pkl"
)

print("\nModel Saved Successfully!")
print("/storage/emulated/0/Download/match_result_ai_v6.pkl")